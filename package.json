{
  "name": "ember-lottie",
  "version": "1.1.3",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:qonto/ember-lottie.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm --filter @qonto/ember-lottie build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "lint:types": "pnpm --filter '*' lint:types",
    "prepare": "pnpm build",
    "postinstall": "lefthook install",
    "release": "release-it",
    "start": "concurrently 'npm:start:*' --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter @qonto/ember-lottie start --no-watch.clearScreen",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter '*' test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@release-it-plugins/workspaces": "^6.0.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "concurrently": "^9.0.1",
    "lefthook": "^2.1.9",
    "prettier": "^3.3.3",
    "release-it": "^19.2.4"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@9.12.3",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  }
}
